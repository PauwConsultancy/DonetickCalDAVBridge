<Project Sdk="Microsoft.NET.Sdk">

  <!-- L2 integration and L3 replay tests: the real application in-process (WebApplicationFactory),
       Donetick as a WireMock.Net stub, fake time. See docs/testing-strategy.md, chapter 5.3. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <!-- Referenced directly (also via DonetickCalDav.Testing) so its build targets copy the
         application's deps file and content root manifest into this project's output. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="WireMock.Net" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DonetickCalDav\DonetickCalDav.csproj" />
    <ProjectReference Include="..\DonetickCalDav.Testing\DonetickCalDav.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
