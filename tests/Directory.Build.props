<Project>
  <!-- Shared settings for every project under tests/. The production project in src/ does not
       see this file, so the Docker build (which only copies src/DonetickCalDav) is unaffected. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- The snapshot helper finds approved files through [CallerFilePath]. Deterministic source paths
         (switched on by ContinuousIntegrationBuild) would rewrite those paths to /_/..., so keep them off. -->
    <DeterministicSourcePaths>false</DeterministicSourcePaths>
  </PropertyGroup>
</Project>
