<Project>
  <!-- Shared settings for every project under tests/. The production project in src/ does not
       see this file, so the Docker build (which only copies src/DonetickCalDav) is unaffected. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
