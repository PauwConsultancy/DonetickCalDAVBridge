@startuml act-request-pipeline
!include style.iuml

title Request pipeline (CalDavMiddleware.InvokeAsync)

start
:Incoming HTTP request;
:Log method, path, auth presence, User-Agent (Debug);

if (path starts with /.well-known/caldav?) then (yes)
  :Set DAV header;
  :301 Location: /caldav/;
  stop
endif

if (path is / or /health?) then (yes)
  :Render HTML status page (200);
  stop
endif

if (path is /health/json?) then (yes)
  :JSON health
  200 if cache has chores, else 503;
  stop
endif

if (path starts with /caldav?) then (no)
  :Pass to next middleware
  (none registered, so 404);
  stop
endif

:Set DAV: 1, 3, access-control, calendar-access;

if (method is OPTIONS?) then (yes)
  :200 + Allow header;
  stop
endif

:AuthenticateAsync("BasicAuth");
if (credentials valid?) then (no)
  :401 + WWW-Authenticate: Basic;
  stop
endif

:ClientTracker.RecordRequest(User-Agent);

switch (method)
case (PROPFIND)
  :PropFindHandler;
case (REPORT)
  :ReportHandler;
case (GET / HEAD)
  :GetHandler;
case (PUT)
  :PutHandler;
case (DELETE)
  :DeleteHandler;
case (PROPPATCH)
  :PropPatchHandler;
case (MOVE)
  :403 + Allow
  (labels cannot be changed);
case (MKCALENDAR / MKCOL)
  :403 + Allow;
case (other)
  :405 + Allow;
endswitch
stop
@enduml
